# Copy this file to `.env` and fill in real values.
# Generate secrets with: npm run strapi secret:generate

# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337

# Secrets — generate via `npm run strapi secret:generate` and never commit
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
ENCRYPTION_KEY=replace-me
JWT_SECRET=replace-me

# Database
DATABASE_CLIENT=postgres
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=false

# Email (Gmail SMTP via Nodemailer)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_REPLY_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Optional: Google Gemini API key (server-side AI features)
GEMINI_API_KEY=

# Bootstrap super admin (created on first run if no admin exists)
SUPER_ADMIN_USER=
SUPER_ADMIN_PASS=
